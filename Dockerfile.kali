# syntax=docker/dockerfile:1

# The console as a Kali image.
#
# The sibling of `Dockerfile`, which is the Arch one, and deliberately a
# separate file rather than the same file with a base argument: the two differ
# in their package manager, their package names and in what their repositories
# carry, so one file would be two files with a conditional between them.
# Everything downstream of the interpreter is identical, including the
# entrypoint, which is shared verbatim -- Kali rolling carries Python 3.14.7,
# the same interpreter Arch does, so the dependency tree resolves to the same
# versions this project is actually run on.
#
# What Kali does not carry is `gh`, which is fetched from GitHub's own apt
# repository below. This image installs no pentest tooling: it is this console,
# on this base. `kali-linux-headless` is the metapackage that adds the toolset,
# at several GB, and it belongs in a derived image rather than here.

# ---------------------------------------------------------------------------
# base: the system packages
# ---------------------------------------------------------------------------
# kali-rolling is a moving tag by design -- pinning a dated one freezes the
# distribution this image exists to track, as archlinux:base does on the other
# side. Reproducibility comes from the digest a build records, not from the tag.
# hadolint ignore=DL3007
FROM kalilinux/kali-rolling:latest AS base

# The Debian spellings of what the Arch image installs. What is absent is the
# same list and for the same reasons: ollama (the daemon stays on the host and
# owns the embedding model's placement on the GPU), a browser to open, and the
# toolchain, which is build-stage only.
# postgresql-client is psql: how the database configuration is proved rather
# than assumed, by the entrypoint and by any script the Builder writes.
# gh comes from GitHub's own repository because Kali carries no package for it,
# and without it `git_dwell` stops at `push` -- its `pr` and `merge` stages are
# the last two of the default pipeline.
ENV DEBIAN_FRONTEND=noninteractive
# No apt version pins below: Kali is rolling, so a pinned version is one that
# leaves the repository within weeks and takes the build with it. The Arch
# image names no pacman versions for the same reason.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        git \
        curl \
        ca-certificates \
        postgresql-client \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/opt/hf-cache \
    PYTHONUNBUFFERED=1

# The installed tree ships no __pycache__: 285 MB of a 990 MB venv, and
# unwritable anyway once the image runs as a user who does not own /opt/venv --
# so every process would recompile the same modules and throw the result away.
# Pointed at a writable directory instead, the first process in a container
# pays the ~1.4s and every one after it reads the cache.
ENV PYTHONPYCACHEPREFIX=/home/agent/.cache/pycache

# ---------------------------------------------------------------------------
# build: the virtualenv
# ---------------------------------------------------------------------------
FROM base AS build

# build-essential and python3-dev for any wheel with no binary for this
# interpreter; binutils for `strip`, below.
# No apt version pins below: Kali is rolling, so a pinned version is one that
# leaves the repository within weeks and takes the build with it. The Arch
# image names no pacman versions for the same reason.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        binutils \
    && rm -rf /var/lib/apt/lists/*

# uv as the installer, from its own image rather than from pip or apt: Kali
# packages no uv, and copying the binary keeps it out of the venv -- so it
# speeds the build without shipping in the runtime image.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN python3 -m venv "$VIRTUAL_ENV"

WORKDIR /app

COPY pyproject.toml ./pyproject.toml
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -e ".[dev]"

# Two dependencies of chromadb this project cannot reach, removed after the
# fact because there is no way to ask for the tree without them: 148 MB.
# `onnxruntime` backs Chroma's own default embedding function, and there is
# exactly one embedding model here, served by the Ollama daemon over HTTP.
# `kubernetes` is its client for a Chroma running as a server; this one runs
# embedded, as files under knowledge/. Measured: the whole suite passes without
# them.
RUN uv pip uninstall onnxruntime kubernetes

# Debug symbols from the compiled extensions, which nothing reads here.
RUN find /opt/venv -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true

# The chunker cuts passages with the embedding model's own tokenizer, loaded
# cache-first and fetched from Hugging Face on a miss. Baking it in means a
# container with no network still chunks, and that the first run does not pay
# for a download while it is indexing. Non-fatal: the runtime path falls back
# to the network.
RUN python - <<'PY' || true
from transformers import AutoTokenizer

from langgraph_agent.graphrag_server import EMBEDDING_TOKENIZER_NAME

AutoTokenizer.from_pretrained(EMBEDDING_TOKENIZER_NAME)
print(f"cached the tokenizer for {EMBEDDING_TOKENIZER_NAME}")
PY

# ---------------------------------------------------------------------------
# runtime: the console
# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/hf-cache /opt/hf-cache
# Readable and lockable by whatever uid the container is given: transformers
# takes a file lock beside a cached repo even when it only reads it.
RUN chmod -R a+rwX /opt/hf-cache

# uid 1000 so the bind-mounted checkout is owned by the uid writing into it and
# a run's products are not left root-owned on the host. Kali's base image
# reserves no uid 1000, so this is the first real account. The home directory
# is world-writable so `--user` with another uid still has somewhere to put a
# git config; nothing secret lives there.
RUN useradd --create-home --uid 1000 --shell /bin/bash agent \
    && chmod 0777 /home/agent

COPY docker/entrypoint.sh /usr/local/bin/ambiguity-entrypoint
COPY --chown=1000:1000 . /app

WORKDIR /app
ENV HOME=/home/agent \
    PORT=8080
EXPOSE 8080
USER 1000:1000

# The same readiness check launch_console.sh waits on: /api/status answers as
# soon as the server is up, and building a corpus does not block it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "curl -fsS \"http://127.0.0.1:${PORT}/api/status\" >/dev/null || exit 1"]

ENTRYPOINT ["/usr/local/bin/ambiguity-entrypoint"]
CMD ["python", "serve.py"]
