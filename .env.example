# Cloud-only configuration: Anthropic is the primary LLM provider.
# OpenAI remains available as an optional cloud provider.
#
# Default team mapping:
#   Planner    -> Anthropic Claude 3.5 Sonnet  (main architect / structural planning)
#   Researcher -> Anthropic Claude 3.5 Haiku    (knowledge gathering)
#   Builder    -> Anthropic Claude 3.5 Haiku     (code implementation)

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional per-agent overrides
# PLANNER_PROVIDER=anthropic
# PLANNER_MODEL=claude-3-5-sonnet-20241022
# RESEARCHER_PROVIDER=anthropic
# RESEARCHER_MODEL=claude-3-5-haiku-20241022
# BUILDER_PROVIDER=anthropic
# BUILDER_MODEL=claude-3-5-haiku-20241022

# --- Optional cloud provider ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# MCP Server URLs (optional - for external MCP integration)
# MCP_GRAPHRAG_URL=http://localhost:8080
# MCP_FILESYSTEM_URL=http://localhost:8081
# MCP_GIT_URL=http://localhost:8082

# LangSmith Tracing (optional - for debugging)
# Uncomment the lines below only if you have a LangSmith API key.
# Leaving tracing enabled without a key will slow or error every run.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=lsv2-...
# LANGCHAIN_PROJECT=langgraph-agent
