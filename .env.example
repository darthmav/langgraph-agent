# Cloud / Remote 3-Model Configuration (no local models required)
# Each agent uses a different model. Ollama endpoints below can point to a
# remote Ollama server; they do not have to be localhost.
#
# Team mapping:
#   Planner    -> Kimi moonshot-v1-8k             (main architect / structural planning)
#   Researcher -> Gemma 4 27B via remote Ollama   (science & dev research)
#   Builder    -> Qwen 3 32B via remote Ollama    (code evaluation / implementation)

PLANNER_PROVIDER=kimi
PLANNER_MODEL=moonshot-v1-8k
PLANNER_BASE_URL=https://api.moonshot.cn/v1
PLANNER_API_KEY=sk-...

RESEARCHER_PROVIDER=ollama
RESEARCHER_MODEL=gemma4:27b
RESEARCHER_BASE_URL=https://your-ollama-server.example.com

BUILDER_PROVIDER=ollama
BUILDER_MODEL=qwen3:32b
BUILDER_BASE_URL=https://your-ollama-server.example.com

# Kimi (Moonshot) global fallback (OpenAI-compatible API)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_API_KEY=sk-...

# Local Ollama Configuration (optional - only enable if you want a local model)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# HuggingFace token (optional - raises rate limits and removes warnings during first model download)
HF_TOKEN=

# OpenAI API Configuration (optional - cloud)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Configuration (optional - cloud)
ANTHROPIC_API_KEY=sk-ant-...

# MCP Server URLs (optional - for external MCP integration)
MCP_GRAPHRAG_URL=http://localhost:8080
MCP_FILESYSTEM_URL=http://localhost:8081
MCP_GIT_URL=http://localhost:8082

# LangSmith Tracing (optional - for debugging)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2-...
LANGCHAIN_PROJECT=langgraph-agent
