# Ollama Cloud - Qwen3.5 (default - best balance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:397b-cloud

# Other cloud options:
# OLLAMA_MODEL=kimi-k2.7-code:cloud    # Kimi - great for coding
# OLLAMA_MODEL=gemma4:cloud            # Gemma - Google's model

# Local LLM (slower, no API needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# OpenAI (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
